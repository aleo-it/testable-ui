{
  "name": "@testable-ui/core",
  "version": "0.1.1",
  "description": "Deterministic semantic test-id naming engine + manifest/registry generation, framework-agnostic",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "keywords": [
    "testing",
    "data-testid",
    "test-id",
    "e2e",
    "testing-library",
    "playwright"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "pnpm build"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "typescript": "^5.8.0"
  }
}